# 依赖：用 pnpm install 重新生成
node_modules/

# 密钥文件：Harness 会从启动目录的 .env 读取 API Key，任何目录下的都不提交
.env
.env.*
!.env.example

# Harness 数据目录：只保留 profile 配置，其余是个人数据
# （.credentials.yaml 里有 API Key；sessions/attachments 是对话记录和截图）
home/*
!home/.agent-presets/
!home/profiles/
home/profiles/*
!home/profiles/web/
home/profiles/web/*
!home/profiles/web/cordis.patch.yml
!home/profiles/web/cordis.yml
!home/profiles/web/package.json
!home/profiles/web/pnpm-lock.yaml
!home/profiles/web/pnpm-workspace.yaml

# 搬家前的旧会话备份、Agent 工作区
old-sessions/
workspace/
